---
import '../styles/global.css';

interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<!-- Import Quicksand Font -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-black text-neutral-300 min-h-screen flex flex-col relative overflow-x-hidden">
		
		<!-- CSS Star Background -->
		<div class="stars-container pointer-events-none"></div>

		<!-- Navigation Bar -->
		<nav class="border-b border-slate-800 bg-slate-900/50 backdrop-blur-md sticky top-0 z-50">
			<div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
				<a href="/" class="text-xl font-bold text-white tracking-widest">EPPPE<span class="text-purple-400">.NET</span></a>
				<div class="space-x-6 text-sm font-semibold tracking-wide">
					<a href="/portfolio" class="hover:text-white transition-colors">Portfolio</a>
					<a href="/vault" class="hover:text-white transition-colors">The Vault</a>
				</div>
			</div>
		</nav>

		<!-- Main Content Area -->
		<main class="grow relative z-10">
			<slot />
		</main>

		<footer class="relative z-10 py-8 text-center border-t border-slate-800 text-slate-600 text-sm mt-12 font-medium">
			&copy; {new Date().getFullYear()} Carmine Iacona. Hosted on Cloudflare Pages.
		</footer>

		<style is:global>
			/* Apply Quicksand globally */
			body {
				font-family: 'Quicksand', sans-serif;
				background: #000000;
			}

			/* Star Panning Animation */
			@keyframes panStars {
				from { background-position: 0 0; }
				to { background-position: -200px -200px; }
			}

			.stars-container {
				position: fixed;
				inset: 0;
				z-index: 0;
				background-color: #000000;
				background-image:
					radial-gradient(1px 1px at 20px 30px, rgba(255,255,255,0.95), rgba(255,255,255,0)),
					radial-gradient(1px 1px at 80px 120px, rgba(255,255,255,0.75), rgba(255,255,255,0)),
					radial-gradient(2px 2px at 140px 70px, rgba(255,255,255,0.85), rgba(255,255,255,0)),
					radial-gradient(1px 1px at 190px 170px, rgba(255,255,255,0.7), rgba(255,255,255,0)),
					radial-gradient(1px 1px at 240px 40px, rgba(255,255,255,0.8), rgba(255,255,255,0)),
					radial-gradient(2px 2px at 310px 150px, rgba(255,255,255,0.9), rgba(255,255,255,0)),
					radial-gradient(1px 1px at 360px 90px, rgba(255,255,255,0.65), rgba(255,255,255,0)),
					radial-gradient(1px 1px at 420px 210px, rgba(255,255,255,0.75), rgba(255,255,255,0));
				background-repeat: repeat;
				background-size: 460px 260px;
				opacity: 0.85;
				/* Move the background diagonally over 90 seconds, looping infinitely */
				animation: panStars 120s linear infinite;
			}
		</style>
	</body>
</html>
