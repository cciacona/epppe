---
import '../styles/global.css';

interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<!-- Import a cleaner body font -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="min-h-screen relative flex flex-col overflow-x-hidden bg-slate-950 text-slate-200 antialiased">
		
		<!-- CSS Star Background -->
		<div class="stars-container pointer-events-none"></div>

		<!-- Navigation Bar -->
		<nav class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/85 backdrop-blur-xl">
			<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
				<a href="/" class="text-lg font-extrabold tracking-[0.22em] text-white uppercase">EPPPE<span class="text-cyan-300">.NET</span></a>
				<div class="flex items-center gap-2 text-sm font-semibold text-slate-400">
					<a href="/portfolio" class="rounded-full px-4 py-2 transition-colors hover:bg-white/5 hover:text-white">Portfolio</a>
					<a href="/vault" class="rounded-full px-4 py-2 transition-colors hover:bg-white/5 hover:text-white">Vault</a>
				</div>
			</div>
		</nav>

		<!-- Main Content Area -->
		<main class="grow relative z-10">
			<slot />
		</main>

		<footer class="relative z-10 py-8 text-center border-t border-slate-800 text-slate-600 text-sm mt-12 font-medium">
			&copy; {new Date().getFullYear()} Carmine Iacona. Hosted on Cloudflare Pages.
		</footer>

		<style is:global>
			body {
				font-family: 'Manrope', sans-serif;
				background:
					radial-gradient(circle at top, rgba(34, 211, 238, 0.12), transparent 34%),
					radial-gradient(circle at 85% 0%, rgba(148, 163, 184, 0.10), transparent 28%),
					#020617;
			}

			/* Star Panning Animation */
			@keyframes panStars {
				from { background-position: 0 0; }
				to { background-position: -200px -200px; }
			}

			.stars-container {
				position: fixed;
				inset: 0;
				z-index: 0;
				background-color: #000000;
				background-image:
					radial-gradient(1px 1px at 20px 30px, rgba(255,255,255,0.95), rgba(255,255,255,0)),
					radial-gradient(1px 1px at 80px 120px, rgba(255,255,255,0.75), rgba(255,255,255,0)),
					radial-gradient(2px 2px at 140px 70px, rgba(255,255,255,0.85), rgba(255,255,255,0)),
					radial-gradient(1px 1px at 190px 170px, rgba(255,255,255,0.7), rgba(255,255,255,0)),
					radial-gradient(1px 1px at 240px 40px, rgba(255,255,255,0.8), rgba(255,255,255,0)),
					radial-gradient(2px 2px at 310px 150px, rgba(255,255,255,0.9), rgba(255,255,255,0)),
					radial-gradient(1px 1px at 360px 90px, rgba(255,255,255,0.65), rgba(255,255,255,0)),
					radial-gradient(1px 1px at 420px 210px, rgba(255,255,255,0.75), rgba(255,255,255,0));
				background-repeat: repeat;
				background-size: 460px 260px;
				opacity: 0.7;
				/* Move the background diagonally over 90 seconds, looping infinitely */
				animation: panStars 120s linear infinite;
			}
		</style>
	</body>
</html>
