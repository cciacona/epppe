---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Carmine Iacona builds and documents practical infrastructure, systems, and troubleshooting work.'
} = Astro.props;

const pathname = Astro.url.pathname;
const navItems = [
	{ href: '/', label: 'Home' },
	{ href: '/portfolio', label: 'Portfolio' },
	{ href: '/vault', label: 'The Vault' }
];

const isActive = (href: string) =>
	href === '/' ? pathname === href : pathname === href || pathname.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#141713" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="site-grid" aria-hidden="true"></div>

		<header class="site-header">
			<div class="shell site-header__inner">
				<a href="/" class="wordmark" aria-label="EPPPE.NET home">
					<span class="wordmark__name">EPPPE</span><span class="wordmark__dot">.NET</span>
				</a>

				<nav class="site-nav" aria-label="Primary navigation">
					{navItems.map((item, index) => (
						<a
							href={item.href}
							class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
							aria-current={isActive(item.href) ? 'page' : undefined}
						>
							<span aria-hidden="true">0{index + 1}</span>
							{item.label}
						</a>
					))}
				</nav>
			</div>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="shell site-footer__inner">
				<div>
					<p class="eyebrow">Carmine Iacona</p>
					<p class="site-footer__statement">Systems made legible.</p>
				</div>
				<div class="site-footer__meta">
					<p>&copy; {new Date().getFullYear()} Carmine Iacona</p>
					<p>Built in Florida · Deployed on Cloudflare</p>
				</div>
			</div>
		</footer>
	</body>
</html>
