---
import Layout from './Layout.astro';
import CompositionNav from '../components/CompositionNav.astro';
import { outcomeHref } from '../data/composition';

interface DocumentSection {
	href: string;
	label: string;
}

interface DocumentMeta {
	title: string;
	description?: string;
	artifactType?: string;
	date?: string;
	status?: string;
	outcomes?: string[];
	sections?: DocumentSection[];
	download?: string;
	downloadLabel?: string;
}

interface Props extends Partial<DocumentMeta> {
	frontmatter?: DocumentMeta;
}

const props = Astro.props as Props;
const meta = props.frontmatter ?? (props as DocumentMeta);
const {
	title,
	description = 'Course artifact from Carmine Iacona’s ENC 1102 composition research portfolio.',
	artifactType = 'Course Artifact',
	date,
	status,
	outcomes = [],
	sections = [],
	download,
	downloadLabel = 'Download original'
} = meta;
---

<Layout title={`${title} | Composition Research Portfolio`} description={description}>
	<header class="document-masthead">
		<div class="shell document-masthead__inner">
			<div class="document-masthead__copy">
				<a class="document-masthead__back" href="/portfolio/composition">Composition Research Portfolio</a>
				<p class="eyebrow">{artifactType}</p>
				<h1>{title}</h1>
				<p class="document-masthead__deck">{description}</p>

				<div class="document-masthead__actions">
					{download && (
						<a class="button button--primary" href={download}>
							{downloadLabel}
							<span aria-hidden="true">↓</span>
						</a>
					)}
					<a class="button button--quiet" href="/portfolio/composition/artifacts">Artifact Index</a>
				</div>
			</div>

			<aside class="document-masthead__meta" aria-label="Artifact details">
				<p class="document-masthead__folio">ENC 1102 / 2026</p>
				<dl>
					{date && (
						<div>
							<dt>Date</dt>
							<dd>{date}</dd>
						</div>
					)}
					{status && (
						<div>
							<dt>Status</dt>
							<dd>{status}</dd>
						</div>
					)}
				</dl>

				{outcomes.length > 0 && (
					<div class="document-masthead__outcomes">
						<p>Connected outcomes</p>
						<ul>
							{outcomes.map((outcome) => <li><a href={outcomeHref(outcome)}>{outcome}</a></li>)}
						</ul>
					</div>
				)}
			</aside>
		</div>
	</header>

	<CompositionNav />

	<div class:list={['document-reading', 'shell', { 'has-toc': sections.length > 0 }]}>
		{sections.length > 0 && (
			<aside class="document-toc">
				<p class="document-toc__label">On this page</p>
				<nav aria-label={`${title} contents`}>
					{sections.map((section, index) => (
						<a href={section.href}>
							<span>{String(index + 1).padStart(2, '0')}</span>
							{section.label}
						</a>
					))}
				</nav>
			</aside>
		)}

		<article class="document-content">
			<slot />
		</article>
	</div>

	<aside class="document-return">
		<div class="shell document-return__inner">
			<div>
				<p class="eyebrow">Course connections</p>
				<p>See the reflections and the other artifacts connected to each outcome.</p>
			</div>
			<div class="document-return__actions">
				<a class="button button--primary" href="/portfolio/composition/outcomes">Outcomes & Reflections</a>
				<a class="button button--quiet" href="/portfolio/composition/artifacts">Artifact Index</a>
			</div>
		</div>
	</aside>
</Layout>

<style>
	.document-masthead {
		position: relative;
		overflow: hidden;
		padding-block: clamp(72px, 9vw, 126px);
		border-bottom: 1px solid var(--rule);
		background:
			linear-gradient(90deg, transparent 0 68%, rgba(193, 165, 126, 0.055) 68% 68.1%, transparent 68.1%),
			radial-gradient(circle at 82% 14%, rgba(91, 123, 100, 0.19), transparent 24rem);
	}

	.document-masthead__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(260px, 0.33fr);
		gap: clamp(44px, 8vw, 110px);
		align-items: end;
	}

	.document-masthead__copy {
		max-width: 850px;
	}

	.document-masthead__back {
		display: inline-block;
		margin-bottom: 34px;
		color: var(--sage);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.document-masthead__back::before {
		margin-right: 10px;
		content: "←";
		color: var(--tan);
	}

	.document-masthead h1 {
		max-width: 900px;
		margin: 16px 0 0;
		color: var(--cream);
		font-family: var(--display);
		font-size: clamp(3.4rem, 7.5vw, 7.2rem);
		font-weight: 400;
		letter-spacing: -0.048em;
		line-height: 0.9;
	}

	.document-masthead__deck {
		max-width: 740px;
		margin: 30px 0 0;
		color: var(--muted);
		font-size: clamp(1rem, 1.5vw, 1.14rem);
		line-height: 1.8;
	}

	.document-masthead__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}

	.document-masthead__meta {
		padding: 22px 0 4px 28px;
		border-left: 1px solid var(--rule-strong);
	}

	.document-masthead__folio {
		margin: 0 0 20px;
		color: var(--tan);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.7rem;
		letter-spacing: 0.14em;
	}

	.document-masthead__meta dl {
		margin: 0;
	}

	.document-masthead__meta dl div {
		display: grid;
		grid-template-columns: 76px 1fr;
		gap: 12px;
		padding: 12px 0;
		border-top: 1px solid var(--rule);
	}

	.document-masthead__meta dt,
	.document-masthead__outcomes > p {
		color: var(--muted);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.document-masthead__meta dd {
		margin: 0;
		color: var(--cream-soft);
		font-size: 0.82rem;
	}

	.document-masthead__outcomes {
		margin-top: 22px;
	}

	.document-masthead__outcomes > p {
		margin: 0 0 10px;
	}

	.document-masthead__outcomes ul {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.document-masthead__outcomes li {
		border: 1px solid var(--rule);
	}

	.document-masthead__outcomes li a {
		display: block;
		padding: 5px 8px;
		color: var(--sage-bright);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		transition: background-color 180ms ease, color 180ms ease;
	}

	.document-masthead__outcomes li a:hover {
		background: var(--paper-raised);
		color: var(--cream);
	}

	.document-reading {
		padding-block: clamp(70px, 9vw, 118px);
	}

	.document-reading.has-toc {
		display: grid;
		grid-template-columns: 190px minmax(0, 800px);
		gap: clamp(52px, 7vw, 88px);
		align-items: start;
		justify-content: center;
	}

	.document-toc {
		position: sticky;
		top: 164px;
		align-self: start;
	}

	.document-toc__label {
		margin: 0 0 15px;
		color: var(--tan);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.document-toc nav {
		border-top: 1px solid var(--rule-strong);
	}

	.document-toc a {
		display: flex;
		gap: 10px;
		padding: 11px 0;
		border-bottom: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.045em;
		line-height: 1.4;
		text-transform: uppercase;
		transition: color 180ms ease, padding-left 180ms ease;
	}

	.document-toc a span {
		flex: 0 0 auto;
		color: var(--rule-strong);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}

	.document-toc a:hover {
		padding-left: 5px;
		color: var(--cream);
	}

	.document-content {
		width: 100%;
		max-width: 800px;
	}

	.document-reading:not(.has-toc) .document-content {
		margin-inline: auto;
	}

	.document-content :global(h2) {
		margin: 4.7rem 0 1.4rem;
		padding-top: 2rem;
		scroll-margin-top: 164px;
		border-top: 1px solid var(--rule-strong);
		color: var(--cream);
		font-family: var(--display);
		font-size: clamp(2.35rem, 4vw, 4rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 1;
	}

	.document-content :global(h2:first-child) {
		margin-top: 0;
	}

	.document-content :global(h3) {
		margin: 2.6rem 0 1rem;
		color: var(--sage-bright);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.document-content :global(p),
	.document-content :global(li) {
		color: var(--cream-soft);
		font-size: clamp(1rem, 1.35vw, 1.08rem);
		line-height: 1.92;
	}

	.document-content :global(p) {
		margin: 0 0 1.4rem;
	}

	.document-content :global(a) {
		color: var(--sage-bright);
		text-decoration: underline;
		text-decoration-color: var(--rule-strong);
		text-underline-offset: 4px;
	}

	.document-content :global(blockquote) {
		margin: 2.5rem 0;
		padding: 22px 26px;
		border: 1px solid var(--rule-strong);
		border-left: 3px solid var(--tan);
		background: var(--forest-deep);
	}

	.document-content :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.document-content :global(ul),
	.document-content :global(ol) {
		margin: 1rem 0 2rem;
		padding-left: 1.4rem;
	}

	.document-content :global(li + li) {
		margin-top: 0.75rem;
	}

	.document-content :global(hr) {
		margin: 4rem 0;
		border: 0;
		border-top: 1px solid var(--rule);
	}

	.document-content :global(table) {
		display: block;
		width: 100%;
		margin: 1.4rem 0 2.4rem;
		overflow-x: auto;
		border-collapse: collapse;
		font-size: 0.82rem;
		line-height: 1.55;
	}

	.document-content :global(th),
	.document-content :global(td) {
		min-width: 150px;
		padding: 12px 14px;
		border: 1px solid var(--rule-strong);
		color: var(--cream-soft);
		text-align: left;
		vertical-align: top;
	}

	.document-content :global(th) {
		background: var(--forest-deep);
		color: var(--sage-bright);
		font-size: 0.72rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.document-content :global(.research-figure) {
		margin: 2.8rem 0;
		padding: 18px;
		border: 1px solid var(--rule-strong);
		background: #fff;
	}

	.document-content :global(.research-figure img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.document-content :global(.research-figure figcaption) {
		margin-top: 14px;
		color: #34463d;
		font-size: 0.74rem;
		line-height: 1.5;
	}

	.document-content :global(.lead) {
		margin-bottom: 3rem;
		padding-bottom: 2.4rem;
		border-bottom: 1px solid var(--rule);
		color: var(--sage-bright);
		font-family: var(--display);
		font-size: clamp(1.65rem, 3vw, 2.45rem);
		line-height: 1.28;
	}

	.document-content :global(.artifact-callout) {
		margin: 2.4rem 0;
		padding: 24px 28px;
		border: 1px solid var(--rule-strong);
		background: var(--paper-soft);
	}

	.document-content :global(.artifact-callout strong) {
		display: block;
		margin-bottom: 8px;
		color: var(--tan);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.document-return {
		border-top: 1px solid var(--rule);
		background: var(--forest-deep);
	}

	.document-return__inner {
		display: flex;
		gap: 34px;
		align-items: center;
		justify-content: space-between;
		padding-block: 44px;
	}

	.document-return__inner p:last-child {
		margin: 8px 0 0;
		color: var(--muted);
	}

	.document-return__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		justify-content: flex-end;
	}

	@media (max-width: 1020px) {
		.document-reading.has-toc {
			grid-template-columns: 1fr;
			gap: 50px;
		}

		.document-toc {
			position: static;
			min-width: 0;
		}

		.document-toc nav {
			display: flex;
			overflow-x: auto;
			mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 34px), transparent 100%);
		}

		.document-toc a {
			flex: 0 0 auto;
			padding: 12px 18px;
			border-right: 1px solid var(--rule);
		}

		.document-content {
			margin-inline: auto;
		}
	}

	@media (max-width: 820px) {
		.document-masthead__inner {
			grid-template-columns: 1fr;
		}

		.document-masthead__meta {
			padding: 22px 0 0;
			border-top: 1px solid var(--rule-strong);
			border-left: 0;
		}

		.document-return__inner {
			align-items: flex-start;
			flex-direction: column;
		}

		.document-return__actions {
			justify-content: flex-start;
		}
	}

	@media (max-width: 680px) {
		.document-reading {
			padding-block: 54px 80px;
		}

		.document-content :global(h2) {
			scroll-margin-top: 148px;
		}
	}
</style>
