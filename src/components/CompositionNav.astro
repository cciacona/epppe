---
const pathname = Astro.url.pathname.replace(/\/$/, '');

const links = [
	{ href: '/portfolio/composition', label: 'Start Here', matches: ['/portfolio/composition'] },
	{ href: '/portfolio/composition/outcomes', label: 'Outcomes & Reflections', matches: ['/portfolio/composition/outcomes'] },
	{
		href: '/portfolio/composition/artifacts',
		label: 'Artifact Index',
		matches: [
			'/portfolio/composition/artifacts',
			'/portfolio/composition/initial-research-proposal',
			'/portfolio/composition/annotated-bibliography'
		]
	},
	{ href: '/portfolio/composition/investigative-field-essay', label: 'Final Paper', matches: ['/portfolio/composition/investigative-field-essay'] },
	{ href: '/portfolio/composition/process-archive', label: 'Process Archive', matches: ['/portfolio/composition/process-archive'] }
];

const isActive = (matches: string[]) => matches.includes(pathname);
---

<nav class="composition-nav" aria-label="Composition portfolio">
	<div class="shell composition-nav__inner">
		<p class="composition-nav__label">ENC 1102</p>
		<div class="composition-nav__links">
			{links.map((link, index) => (
				<a
					href={link.href}
					class:list={['composition-nav__link', { 'is-active': isActive(link.matches) }]}
					aria-current={isActive(link.matches) ? 'page' : undefined}
				>
					<span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
					{link.label}
				</a>
			))}
		</div>
	</div>
</nav>

<style>
	.composition-nav {
		position: sticky;
		top: 78px;
		z-index: 40;
		border-block: 1px solid var(--rule);
		background: rgba(16, 35, 28, 0.92);
		backdrop-filter: blur(14px);
	}

	.composition-nav__inner {
		display: flex;
		align-items: stretch;
		justify-content: space-between;
		min-height: 58px;
	}

	.composition-nav__label {
		display: flex;
		align-items: center;
		margin: 0;
		padding-right: 28px;
		border-right: 1px solid var(--rule);
		color: var(--sage-bright);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.composition-nav__links {
		display: flex;
		overflow-x: auto;
	}

	.composition-nav__link {
		display: inline-flex;
		gap: 8px;
		align-items: center;
		padding: 0 18px;
		border-left: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		white-space: nowrap;
		transition: color 180ms ease, background-color 180ms ease;
	}

	.composition-nav__link span {
		color: var(--rule-strong);
		font-size: 0.62rem;
	}

	.composition-nav__link:hover,
	.composition-nav__link.is-active {
		background: rgba(238, 232, 220, 0.045);
		color: var(--cream);
	}

	.composition-nav__link.is-active span {
		color: var(--tan);
	}

	@media (max-width: 820px) {
		.composition-nav__inner {
			width: 100%;
		}

		.composition-nav__label {
			display: none;
		}

		.composition-nav__links {
			width: 100%;
			padding-right: 34px;
			mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 34px), transparent 100%);
		}

		.composition-nav__link {
			flex: 0 0 auto;
			padding: 0 16px;
		}
	}

	@media (max-width: 680px) {
		.composition-nav {
			top: 67px;
		}
	}
</style>
