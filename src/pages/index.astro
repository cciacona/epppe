---
import Layout from '../layouts/Layout.astro';

const focusAreas = [
	{
		title: 'Cloud and network systems',
		description: 'Infrastructure, service hosting, and the small operational details that keep a site or server useful after launch.'
	},
	{
		title: 'Windows-first troubleshooting',
		description: 'Native Windows 11 administration, PowerShell workflows, and practical system cleanup before reaching for heavier tools.'
	},
	{
		title: 'Engine diagnostics',
		description: 'Rendering, compilation, and environment issues across Unreal Engine and Godot projects.'
	}
];

const technicalStack = [
	['Languages', 'Python, C++, C, Java'],
	['Systems', 'Windows 11 Admin, PowerShell'],
	['Engines', 'Godot 4, Unreal Engine 5'],
	['Hardware', 'GPU undervolting and tuning']
];

const selectedWork = [
	{
		title: 'Engine Rendering Diagnostics',
		meta: 'Unreal Engine 5 / Godot 4',
		description: 'Diagnosed compile and environment problems, then translated the fix into practical project logic and repeatable notes.',
		href: '/portfolio'
	},
	{
		title: 'Personal Service Stack',
		meta: 'Vault / media / reviews',
		description: 'A public-facing archive for services, catalog entries, and experiments that benefit from being kept outside a resume.',
		href: '/vault'
	},
	{
		title: 'Composition Research Portfolio',
		meta: 'Course evidence / revision work',
		description: 'A prepared space for the research paper, reflections, drafts, screenshots, and writing activity evidence.',
		href: '/portfolio/composition'
	}
];
---

<Layout title="Carmine Iacona | Cloud & Network Engineering">
	<div class="mx-auto max-w-6xl px-6 py-16">
		<header class="grid grid-cols-1 gap-10 border-b border-slate-800 pb-14 lg:grid-cols-3">
			<div class="lg:col-span-2">
				<p class="mb-3 text-sm font-bold text-cyan-300">Carmine Iacona</p>
				<h1 class="max-w-3xl text-4xl font-bold leading-tight text-white">
					Cloud infrastructure, systems, and practical troubleshooting.
				</h1>
				<p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-400">
					B.S. CECS student at UCF focused on infrastructure, network engineering, and automation.
				</p>
				<div class="mt-8 flex flex-wrap gap-3 text-sm font-bold">
					<a href="/portfolio" class="border border-slate-700 px-4 py-2 text-white transition-colors hover:border-cyan-400 hover:text-cyan-200">Portfolio</a>
					<a href="/vault" class="border border-slate-700 px-4 py-2 text-slate-300 transition-colors hover:border-cyan-300 hover:text-cyan-200">Vault</a>
				</div>
			</div>

			<aside class="border-t border-slate-800 pt-6 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
				<h2 class="mb-5 text-lg font-bold text-white">Working Notes</h2>
				<div class="space-y-5 text-sm leading-relaxed">
					<div>
						<p class="font-bold text-cyan-300">Current lane</p>
						<p class="mt-1 text-slate-400">Cloud infrastructure, networking, and service reliability.</p>
					</div>
					<div>
						<p class="font-bold text-amber-300">Useful habit</p>
						<p class="mt-1 text-slate-400">Start with the system in front of me, then document the fix clearly enough to repeat.</p>
					</div>
					<div>
						<p class="font-bold text-emerald-300">Course work</p>
						<p class="mt-1 text-slate-400">Composition portfolio structure is ready for research and reflection artifacts.</p>
					</div>
				</div>
			</aside>
		</header>

		<section class="grid grid-cols-1 gap-10 border-b border-slate-800 py-12 lg:grid-cols-3">
			<div>
				<h2 class="text-2xl font-bold text-white">Technical Core</h2>
				<p class="mt-3 leading-relaxed text-slate-500">
					The tools and systems behind the work.
				</p>
			</div>

			<div class="lg:col-span-2">
				<div class="divide-y divide-slate-800 border-y border-slate-800">
					{technicalStack.map(([label, value]) => (
						<div class="grid grid-cols-1 gap-2 py-4 sm:grid-cols-3">
							<p class="font-bold text-slate-200">{label}</p>
							<p class="sm:col-span-2 text-slate-400">{value}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="grid grid-cols-1 gap-10 border-b border-slate-800 py-12 lg:grid-cols-3">
			<div>
				<h2 class="text-2xl font-bold text-white">Focus Areas</h2>
				<p class="mt-3 leading-relaxed text-slate-500">
					Where the technical work tends to cluster.
				</p>
			</div>

			<div class="lg:col-span-2">
				<div class="divide-y divide-slate-800 border-y border-slate-800">
					{focusAreas.map((area) => (
						<article class="py-5">
							<h3 class="text-xl font-bold text-white">{area.title}</h3>
							<p class="mt-2 leading-relaxed text-slate-400">{area.description}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="grid grid-cols-1 gap-10 py-12 lg:grid-cols-3">
			<div>
				<h2 class="text-2xl font-bold text-white">Selected Work</h2>
				<p class="mt-3 leading-relaxed text-slate-500">
					A selection of representative work and supporting material.
				</p>
			</div>

			<div class="lg:col-span-2">
				<div class="divide-y divide-slate-800 border-y border-slate-800">
					{selectedWork.map((work) => (
						<a href={work.href} class="group block py-5 transition-colors hover:bg-slate-900/40">
							<div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
								<p class="text-sm font-bold text-cyan-300">{work.meta}</p>
								<div class="sm:col-span-3">
									<h3 class="text-xl font-bold text-white group-hover:text-cyan-200">{work.title}</h3>
									<p class="mt-2 leading-relaxed text-slate-400">{work.description}</p>
								</div>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>
	</div>
</Layout>
