---
import Layout from '../layouts/Layout.astro';
import SystemsPlate from '../components/SystemsPlate.astro';

const focusAreas = [
	{
		title: 'Home server',
		description: 'I run Minecraft and Jellyfin from a dedicated PC using Proxmox VE. I handle the service setup, networking, updates, and troubleshooting.'
	},
	{
		title: 'Factorio mods',
		description: 'I update older mods for Factorio 2.1, test the changes, and publish the maintained versions on GitHub and the Factorio mod portal.'
	},
	{
		title: 'Attractions operations',
		description: 'I have worked in Attractions Operations at Universal Orlando since August 2023. The job depends on safety procedures, clear communication, and staying calm when something goes wrong.'
	}
];

const technicalStack = [
	['Systems', 'Proxmox VE, Linux, Windows 11'],
	['Languages', 'Python, Java, C, C++, Lua'],
	['Tools', 'Git, GitHub, PowerShell'],
	['Services', 'Minecraft, Jellyfin, Cloudflare Pages']
];

const selectedWork = [
	{
		title: 'Factorio 2.1 Mods',
		meta: 'Lua / Factorio / GitHub',
		description: 'Four maintained mods: Fire Extinguisher, Flammable Oils, Nicer Fuel Glow, and Ammo & Turret Tweaks.',
		href: 'https://github.com/cciacona'
	},
	{
		title: 'Proxmox Home Server',
		meta: 'Proxmox VE / Minecraft / Jellyfin',
		description: 'A dedicated PC hosts the Minecraft server and Jellyfin instance linked from the Vault.',
		href: '/vault'
	},
	{
		title: 'Composition Research Portfolio',
		meta: 'ENC 1102 / Primary research',
		description: 'A semester project about student-run class group chats, with five interviews, three major assignments, and the revision process.',
		href: '/portfolio/composition'
	}
];
---

<Layout title="Carmine Iacona | Information Technology Student">
	<section class="hero shell">
		<div class="hero__copy">
			<p class="eyebrow">Carmine Iacona · Orlando, Florida</p>
			<h1>
				I build, host,<br />
				<span>and fix things.</span>
			</h1>
			<p class="hero__lede">
				I’m an Information Technology student at UCF. Most of my projects involve
				my Proxmox home server, Factorio mods, or this website.
			</p>
			<div class="button-row">
				<a href="/portfolio" class="button button--primary">
					View projects
					<span aria-hidden="true">↗</span>
				</a>
				<a href="/vault" class="button button--quiet">Open the Vault</a>
			</div>
		</div>

		<div class="hero__visual">
			<SystemsPlate />
			<p class="hero__caption">
				<span>Home lab</span>
				A dedicated Proxmox PC hosts Minecraft and Jellyfin.
			</p>
		</div>
	</section>

	<div class="proof-strip">
		<div class="shell proof-strip__inner">
			<div class="proof-strip__intro">
				<span class="status-dot"></span>
				Orlando, Florida
			</div>
			<div class="proof-strip__item">
				<span>01</span>
				<p>UCF<br /><strong>B.S. Information Technology · Dec. 2027</strong></p>
			</div>
			<div class="proof-strip__item">
				<span>02</span>
				<p>Universal Orlando<br /><strong>Attractions Operations · Since 2023</strong></p>
			</div>
			<div class="proof-strip__item">
				<span>03</span>
				<p>CompTIA<br /><strong>TestOut IT Fundamentals Pro · Jul. 2024</strong></p>
			</div>
		</div>
	</div>

	<section class="section shell split-section">
		<div class="section-heading">
			<p class="eyebrow">Toolkit · 01</p>
			<h2>What I<br /><em>use</em></h2>
			<p>The software and platforms behind the projects on this site.</p>
		</div>

		<div class="ruled-list">
			{technicalStack.map(([label, value], index) => (
				<div class="ruled-list__row">
					<span class="ruled-list__number">0{index + 1}</span>
					<h3>{label}</h3>
					<p>{value}</p>
				</div>
			))}
		</div>
	</section>

	<section class="section section--forest">
		<div class="shell">
			<div class="section-heading section-heading--horizontal">
				<div>
					<p class="eyebrow">Experience · 02</p>
					<h2>What I<br /><em>do</em></h2>
				</div>
				<p>My home server, mod projects, and work at Universal.</p>
			</div>

			<div class="focus-grid">
				{focusAreas.map((area, index) => (
					<article class="focus-card">
						<p class="focus-card__index">0{index + 1} / 03</p>
						<h3>{area.title}</h3>
						<p>{area.description}</p>
						<div class="focus-card__mark" aria-hidden="true"></div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section shell">
		<div class="section-heading section-heading--horizontal">
			<div>
				<p class="eyebrow">Selected work · 03</p>
				<h2>Selected<br /><em>projects</em></h2>
			</div>
			<p>Technical projects, hosted services, and my ENC 1102 portfolio.</p>
		</div>

		<div class="work-list">
			{selectedWork.map((work, index) => (
				<a href={work.href} class="work-row">
					<span class="work-row__number">0{index + 1}</span>
					<div>
						<p class="work-row__meta">{work.meta}</p>
						<h3>{work.title}</h3>
					</div>
					<p class="work-row__description">{work.description}</p>
					<span class="work-row__arrow" aria-hidden="true">↗</span>
				</a>
			))}
		</div>
	</section>
</Layout>
