---
import Layout from '../layouts/Layout.astro';
import SystemsPlate from '../components/SystemsPlate.astro';

const focusAreas = [
	{
		title: 'Cloud and network systems',
		description: 'Infrastructure, service hosting, and the small operational details that keep a site or server useful after launch.'
	},
	{
		title: 'Windows-first troubleshooting',
		description: 'Native Windows 11 administration, PowerShell workflows, and practical system cleanup before reaching for heavier tools.'
	},
	{
		title: 'Engine diagnostics',
		description: 'Rendering, compilation, and environment issues across Unreal Engine and Godot projects.'
	}
];

const technicalStack = [
	['Languages', 'Python, C++, C, Java'],
	['Systems', 'Windows 11 Admin, PowerShell'],
	['Engines', 'Godot 4, Unreal Engine 5'],
	['Hardware', 'GPU undervolting and tuning']
];

const selectedWork = [
	{
		title: 'Engine Rendering Diagnostics',
		meta: 'Unreal Engine 5 / Godot 4',
		description: 'Diagnosed compile and environment problems, then translated the fix into practical project logic and repeatable notes.',
		href: '/portfolio'
	},
	{
		title: 'Personal Service Stack',
		meta: 'Vault / media / reviews',
		description: 'A public-facing archive for services, catalog entries, and experiments that benefit from being kept outside a resume.',
		href: '/vault'
	},
	{
		title: 'Composition Research Portfolio',
		meta: 'Course evidence / revision work',
		description: 'A prepared space for the research paper, reflections, drafts, screenshots, and writing activity evidence.',
		href: '/portfolio/composition'
	}
];
---

<Layout title="Carmine Iacona | Cloud & Network Engineering">
	<section class="hero shell">
		<div class="hero__copy">
			<p class="eyebrow">Carmine Iacona · Orlando, Florida</p>
			<h1>
				Infrastructure,<br />
				<span>made practical.</span>
			</h1>
			<p class="hero__lede">
				Information Technology student at UCF focused on cloud infrastructure,
				network engineering, automation, and the operational details that keep systems useful.
			</p>
			<div class="button-row">
				<a href="/portfolio" class="button button--primary">
					Explore the work
					<span aria-hidden="true">↗</span>
				</a>
				<a href="/vault" class="button button--quiet">Enter the vault</a>
			</div>
		</div>

		<div class="hero__visual">
			<SystemsPlate />
			<p class="hero__caption">
				<span>Practice 01</span>
				Self-hosted services, network systems, and repeatable troubleshooting.
			</p>
		</div>
	</section>

	<div class="proof-strip">
		<div class="shell proof-strip__inner">
			<div class="proof-strip__intro">
				<span class="status-dot"></span>
				Building in public
			</div>
			<div class="proof-strip__item">
				<span>01</span>
				<p>UCF<br /><strong>Information Technology</strong></p>
			</div>
			<div class="proof-strip__item">
				<span>02</span>
				<p>Primary lane<br /><strong>Cloud + networking</strong></p>
			</div>
			<div class="proof-strip__item">
				<span>03</span>
				<p>Working method<br /><strong>Build · test · document</strong></p>
			</div>
		</div>
	</div>

	<section class="section shell split-section">
		<div class="section-heading">
			<p class="eyebrow">Capabilities · 01</p>
			<h2>Technical<br /><em>core</em></h2>
			<p>The tools are only useful when they produce clear, repeatable outcomes.</p>
		</div>

		<div class="ruled-list">
			{technicalStack.map(([label, value], index) => (
				<div class="ruled-list__row">
					<span class="ruled-list__number">0{index + 1}</span>
					<h3>{label}</h3>
					<p>{value}</p>
				</div>
			))}
		</div>
	</section>

	<section class="section section--forest">
		<div class="shell">
			<div class="section-heading section-heading--horizontal">
				<div>
					<p class="eyebrow">Practice · 02</p>
					<h2>Where I<br /><em>work best</em></h2>
				</div>
				<p>Problems with enough complexity to require care—and enough practical value to justify it.</p>
			</div>

			<div class="focus-grid">
				{focusAreas.map((area, index) => (
					<article class="focus-card">
						<p class="focus-card__index">0{index + 1} / 03</p>
						<h3>{area.title}</h3>
						<p>{area.description}</p>
						<div class="focus-card__mark" aria-hidden="true"></div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section shell">
		<div class="section-heading section-heading--horizontal">
			<div>
				<p class="eyebrow">Selected work · 03</p>
				<h2>Evidence over<br /><em>adjectives</em></h2>
			</div>
			<p>Technical work, course artifacts, and the notes that make each project understandable.</p>
		</div>

		<div class="work-list">
			{selectedWork.map((work, index) => (
				<a href={work.href} class="work-row">
					<span class="work-row__number">0{index + 1}</span>
					<div>
						<p class="work-row__meta">{work.meta}</p>
						<h3>{work.title}</h3>
					</div>
					<p class="work-row__description">{work.description}</p>
					<span class="work-row__arrow" aria-hidden="true">↗</span>
				</a>
			))}
		</div>
	</section>

	<section class="closing-note shell">
		<p class="eyebrow">Working note · 04</p>
		<blockquote>
			Start with the system in front of me. Understand the failure. Leave behind a fix someone can repeat.
		</blockquote>
	</section>
</Layout>
