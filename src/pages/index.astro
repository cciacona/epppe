---
import Layout from '../layouts/Layout.astro';

const focusAreas = [
	{
		title: 'Cloud and network systems',
		description: 'Infrastructure, service hosting, and the small operational details that keep a site or server useful after launch.'
	},
	{
		title: 'Windows-first troubleshooting',
		description: 'Native Windows 11 administration, PowerShell workflows, and practical system cleanup before reaching for heavier tools.'
	},
	{
		title: 'Engine diagnostics',
		description: 'Rendering, compilation, and environment issues across Unreal Engine and Godot projects.'
	}
];

const technicalStack = [
	['Languages', 'Python, C++, C, Java'],
	['Systems', 'Windows 11 Admin, PowerShell'],
	['Engines', 'Godot 4, Unreal Engine 5'],
	['Hardware', 'GPU undervolting and tuning']
];

const selectedWork = [
	{
		title: 'Engine Rendering Diagnostics',
		meta: 'Unreal Engine 5 / Godot 4',
		description: 'Diagnosed compile and environment problems, then translated the fix into practical project logic and repeatable notes.',
		href: '/portfolio'
	},
	{
		title: 'Personal Service Stack',
		meta: 'Vault / media / reviews',
		description: 'A public-facing archive for services, catalog entries, and experiments that benefit from being kept outside a resume.',
		href: '/vault'
	},
	{
		title: 'Composition Research Portfolio',
		meta: 'Course evidence / revision work',
		description: 'A prepared space for the research paper, reflections, drafts, screenshots, and writing activity evidence.',
		href: '/portfolio/composition'
	}
];
---

<Layout title="Carmine Iacona | Cloud & Network Engineering">
	<div class="mx-auto max-w-6xl px-6 py-12 sm:py-16 lg:py-20">
		<section class="grid gap-6 lg:grid-cols-[1.4fr_0.9fr]">
			<div class="rounded-3xl border border-white/10 bg-slate-950/75 p-8 shadow-[0_24px_80px_rgba(2,6,23,0.35)] sm:p-10">
				<p class="text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Carmine Iacona</p>
				<h1 class="mt-4 max-w-2xl text-4xl font-semibold leading-tight tracking-tight text-white sm:text-5xl">
					Cloud infrastructure, systems, and practical troubleshooting.
				</h1>
				<p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">
					B.S. CECS student at UCF focused on infrastructure, network engineering, and automation.
				</p>
				<div class="mt-8 flex flex-wrap gap-3 text-sm font-semibold">
					<a href="/portfolio" class="rounded-full border border-white/10 bg-white/5 px-5 py-3 text-white transition-colors hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100">Portfolio</a>
					<a href="/vault" class="rounded-full border border-white/10 px-5 py-3 text-slate-300 transition-colors hover:border-white/20 hover:bg-white/5 hover:text-white">Vault</a>
				</div>
			</div>

			<aside class="rounded-3xl border border-white/10 bg-white/5 p-6 sm:p-8">
				<h2 class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-400">Working Notes</h2>
				<div class="mt-6 space-y-4 text-sm leading-relaxed">
					<div class="rounded-2xl border border-white/10 bg-slate-950/60 p-4">
						<p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-300">Current lane</p>
						<p class="mt-2 text-slate-300">Cloud infrastructure, networking, and service reliability.</p>
					</div>
					<div class="rounded-2xl border border-white/10 bg-slate-950/60 p-4">
						<p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-300">Useful habit</p>
						<p class="mt-2 text-slate-300">Start with the system in front of me, then document the fix clearly enough to repeat.</p>
					</div>
					<div class="rounded-2xl border border-white/10 bg-slate-950/60 p-4">
						<p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-200">Course work</p>
						<p class="mt-2 text-slate-300">Composition portfolio structure is ready for research and reflection artifacts.</p>
					</div>
				</div>
			</aside>
		</section>

		<section class="mt-8 grid gap-6 lg:grid-cols-3">
			<article class="rounded-3xl border border-white/10 bg-slate-950/65 p-6 shadow-[0_18px_60px_rgba(2,6,23,0.25)]">
				<h2 class="text-lg font-semibold uppercase tracking-[0.22em] text-slate-400">Technical Core</h2>
				<p class="mt-3 text-sm leading-7 text-slate-300">The tools and systems behind the work.</p>
				<div class="mt-6 grid gap-3">
					{technicalStack.map(([label, value]) => (
						<div class="rounded-2xl border border-white/10 bg-white/5 p-4">
							<p class="text-sm font-semibold text-white">{label}</p>
							<p class="mt-1 text-sm leading-6 text-slate-300">{value}</p>
						</div>
					))}
				</div>
			</article>

			<article class="rounded-3xl border border-white/10 bg-slate-950/65 p-6 shadow-[0_18px_60px_rgba(2,6,23,0.25)]">
				<h2 class="text-lg font-semibold uppercase tracking-[0.22em] text-slate-400">Focus Areas</h2>
				<p class="mt-3 text-sm leading-7 text-slate-300">Where the technical work tends to cluster.</p>
				<div class="mt-6 space-y-3">
					{focusAreas.map((area) => (
						<div class="rounded-2xl border border-white/10 bg-white/5 p-4">
							<h3 class="text-base font-semibold text-white">{area.title}</h3>
							<p class="mt-2 text-sm leading-6 text-slate-300">{area.description}</p>
						</div>
					))}
				</div>
			</article>

			<article class="rounded-3xl border border-white/10 bg-slate-950/65 p-6 shadow-[0_18px_60px_rgba(2,6,23,0.25)]">
				<h2 class="text-lg font-semibold uppercase tracking-[0.22em] text-slate-400">Selected Work</h2>
				<p class="mt-3 text-sm leading-7 text-slate-300">A selection of representative work and supporting material.</p>
				<div class="mt-6 space-y-3">
					{selectedWork.map((work) => (
						<a href={work.href} class="group block rounded-2xl border border-white/10 bg-white/5 p-4 transition-colors hover:border-cyan-300/40 hover:bg-cyan-300/5">
							<p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-300">{work.meta}</p>
							<h3 class="mt-2 text-lg font-semibold text-white group-hover:text-cyan-100">{work.title}</h3>
							<p class="mt-2 text-sm leading-6 text-slate-300">{work.description}</p>
						</a>
					))}
				</div>
			</article>
		</section>
	</div>
</Layout>
