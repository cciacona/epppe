---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		category: 'Game modding',
		title: 'Factorio mod maintenance',
		description: 'I maintain four mods for Factorio 2.1: Fire Extinguisher, Flammable Oils, Nicer Fuel Glow, and Ammo & Turret Tweaks.',
		href: 'https://github.com/cciacona',
		linkLabel: 'Browse on GitHub',
		tags: 'Lua · Factorio 2.1'
	},
	{
		category: 'Self-hosting',
		title: 'Proxmox home server',
		description: 'A dedicated PC running Proxmox VE hosts my Minecraft server and Jellyfin. I handle the networking, updates, and troubleshooting.',
		href: '/vault',
		linkLabel: 'See hosted services',
		tags: 'Proxmox VE · Minecraft · Jellyfin'
	},
	{
		category: 'Research & writing',
		title: 'Class group chats: a research portfolio',
		description: 'My ENC 1102 research portfolio follows a semester of interviews, writing, and revision about student-run class group chats.',
		href: '/portfolio/composition',
		linkLabel: 'Read the portfolio',
		tags: 'ENC 1102 · Primary research'
	}
];

const toolkit = [
	['Systems', 'Windows 11, Proxmox VE'],
	['Languages', 'Python, Java, Lua, C'],
	['Tools', 'Git, GitHub, PowerShell, VSC, MSYS2'],
	['Services', 'Minecraft, Jellyfin, Cloudflare']
];
---

<Layout title="Carmine Iacona | EPPPE.NET">
	<section class="home-intro shell" aria-labelledby="intro-heading">
		<div class="home-intro__copy">
			<p class="home-location">Orlando, Florida</p>
			<h1 id="intro-heading">Carmine<br />Iacona<span>.</span></h1>
			<p class="home-intro__lede">
				I’m a CECS student at UCF. Outside class, I spend a lot of time
				maintaining game mods and getting my home server to behave.
			</p>
			<a class="text-link" href="https://github.com/cciacona">
				Find me on GitHub <span aria-hidden="true">↗</span>
			</a>
		</div>

		<aside class="home-directory" aria-label="Explore this site">
			<p class="home-directory__label">Elsewhere on this site</p>
			<a href="/portfolio">
				<div>
					<h2>Portfolio</h2>
					<p>Technical projects and my<br class="desktop-break" /> composition research.</p>
				</div>
				<span aria-hidden="true">↗</span>
			</a>
			<a href="/vault">
				<div>
					<h2>The Vault</h2>
					<p>Hosted services, media reviews,<br class="desktop-break" /> and creative writing.</p>
				</div>
				<span aria-hidden="true">↗</span>
			</a>
			<p class="home-directory__footnote">A place for the things I work on.</p>
		</aside>
	</section>

	<section class="project-notes shell" aria-labelledby="projects-heading">
		<div class="project-notes__intro">
			<p class="eyebrow">Selected work</p>
			<h2 id="projects-heading">Projects &amp;<br /> writing.</h2>
			<p>The code, systems, and writing I’ve been working on.</p>
		</div>
		<div class="project-notes__list">
			{projects.map((project) => (
				<article class="project-note">
					<p class="project-note__category">{project.category}</p>
					<h3><a href={project.href}>{project.title}<span aria-hidden="true"> ↗</span></a></h3>
					<p class="project-note__description">{project.description}</p>
					<div class="project-note__bottom">
						<span>{project.tags}</span>
						<a href={project.href}>{project.linkLabel} <span aria-hidden="true">→</span></a>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="home-details shell" aria-label="Background and toolkit">
		<div class="home-background">
			<p class="eyebrow">Background</p>
			<h2>Work &amp; study.</h2>
			<p>I’ve worked in Park Operations at Universal Orlando since August 2023.</p>
			<dl class="background-facts">
				<div><dt>Studying</dt><dd>CECS at UCF</dd></div>
				<div><dt>Certification</dt><dd>CompTIA IT Fundamentals Pro<br /><span>July 2024</span></dd></div>
			</dl>
		</div>
		<div class="home-toolkit">
			<p class="eyebrow">Toolkit</p>
			<h2>Tools I use.</h2>
			<dl>
				{toolkit.map(([label, value]) => (
					<div><dt>{label}</dt><dd>{value}</dd></div>
				))}
			</dl>
		</div>
	</section>
</Layout>
