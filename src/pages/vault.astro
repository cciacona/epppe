---
import Layout from '../layouts/Layout.astro';
---

<Layout title="The Vault | EPPPE.NET">
	<div class="max-w-5xl mx-auto px-6 py-16">
		
		<div class="mb-12">
			<h1 class="text-4xl font-bold text-white mb-2">The Vault</h1>
			<p class="text-slate-400">Homelab services, media reviews, and creative writing.</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			
			<div class="space-y-6">
				
				<div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-lg">
					<div class="flex items-center justify-between mb-4">
						<h3 class="text-lg font-bold text-white flex items-center gap-2">
							<span class="w-3 h-3 rounded-full bg-slate-600" id="mc-status-dot"></span>
							Minecraft Server
						</h3>
						<span id="mc-players" class="text-sm font-medium text-slate-400">Pinging...</span>
					</div>
					
					<button 
						id="mc-copy-btn"
						class="w-full bg-slate-800 hover:bg-purple-600 hover:text-white transition-all text-purple-400 font-mono text-sm py-3 rounded-lg border border-slate-700 focus:outline-none focus:ring-2 focus:ring-purple-500"
					>
						play.epppe.net
					</button>
					<p class="text-xs text-center mt-2 text-slate-500">Click to copy server address</p>
				</div>

				<div class="grid grid-cols-2 gap-4">
					<a href="https://stream.epppe.net" target="_blank" class="block bg-slate-900 border border-slate-800 p-4 rounded-xl text-center hover:border-purple-500 transition-colors">
						<span class="block text-purple-400 font-bold mb-1">Jellyfin</span>
						<span class="text-xs text-slate-400">Media Server</span>
					</a>
					<a href="https://map.epppe.net" target="_blank" class="block bg-slate-900 border border-slate-800 p-4 rounded-xl text-center hover:border-green-500 transition-colors">
						<span class="block text-green-400 font-bold mb-1">Live Map</span>
						<span class="text-xs text-slate-400">Server Render</span>
					</a>
				</div>
			</div>

			<div class="md:col-span-2 space-y-8">
				
				<section>
					<h2 class="text-2xl font-bold text-white mb-4 border-b border-slate-800 pb-2">Media Catalog</h2>
					<div id="reviews-status" class="bg-slate-900 border border-slate-800 rounded-xl p-6 flex items-center justify-center min-h-32">
						<p class="text-slate-500 italic">Loading reviews...</p>
					</div>
					<div id="reviews-list" class="mt-4 space-y-4"></div>
				</section>

				<section>
					<h2 class="text-2xl font-bold text-white mb-4 border-b border-slate-800 pb-2">Creative Writing</h2>
					<article class="bg-slate-900 border border-slate-800 rounded-xl p-6">
						<h3 class="text-lg font-bold text-white">Arelis: The City Between Bells</h3>
						<p class="text-sm text-slate-400 mt-2">Chapter 1 Rough Draft - Original Gaslamp Fantasy Novella.</p>
					</article>
				</section>

			</div>
		</div>
	</div>

<!-- Client-side JavaScript for the Minecraft Widget -->
	<script>
		const mcIp = 'play.epppe.net';
		
		// 1. Fetch live server data
		async function checkServer() {
			try {
				const response = await fetch(`https://api.mcsrvstat.us/3/${mcIp}`);
				const data = await response.json();
				
				// Add "!" to tell TypeScript these elements definitely exist
				const dot = document.getElementById('mc-status-dot')!;
				const players = document.getElementById('mc-players')!;
				
				if (data.online) {
					dot.classList.replace('bg-slate-600', 'bg-green-500');
					dot.classList.add('shadow-[0_0_10px_rgba(34,197,94,0.5)]'); // Green glow
					players.innerText = `${data.players.online} / ${data.players.max} Online`;
				} else {
					dot.classList.replace('bg-slate-600', 'bg-red-500');
					players.innerText = 'Offline';
				}
			} catch (error) {
				// Added "!" here as well
				document.getElementById('mc-players')!.innerText = 'Error checking status';
			}
		}

		// 2. Click to copy functionality
		// Add "!" to tell TypeScript the button exists
		const copyBtn = document.getElementById('mc-copy-btn')!;
		
		copyBtn.addEventListener('click', async () => {
			await navigator.clipboard.writeText(mcIp);
			const originalText = copyBtn.innerText;
			
			copyBtn.innerText = 'Copied to clipboard!';
			copyBtn.classList.replace('text-purple-400', 'text-white');
			copyBtn.classList.add('bg-purple-600');
			
			setTimeout(() => {
				copyBtn.innerText = originalText;
				copyBtn.classList.replace('text-white', 'text-purple-400');
				copyBtn.classList.remove('bg-purple-600');
			}, 2000);
		});

		// Run the check when the page loads
		checkServer();

		const reviewsStatus = document.getElementById('reviews-status')!;
		const reviewsList = document.getElementById('reviews-list')!;

		function escapeHtml(value: string) {
			return String(value || '').replace(/[&<>"']/g, (char) => ({
				'&': '&amp;',
				'<': '&lt;',
				'>': '&gt;',
				'"': '&quot;',
				"'": '&#039;'
			})[char] || char);
		}

		function ratingLabel(rating: number | null) {
			if (!rating) return '';
			return `<span class="text-purple-300">${rating}/5</span>`;
		}

		type PublishedReview = {
			title: string;
			body: string;
			category?: string;
			status?: string;
			format?: string;
			release_date?: string;
			runtime?: string;
			votes?: string;
			rating: number | null;
			external_url?: string;
		};

		async function loadReviews() {
			try {
				const response = await fetch('/api/reviews');
				const data = await response.json() as { error?: string; reviews?: PublishedReview[] };

				if (!response.ok) throw new Error(data.error || 'Unable to load reviews');

				const reviews = data.reviews || [];
				if (!reviews.length) {
					reviewsStatus.innerHTML = '<p class="text-slate-500 italic">No published reviews yet.</p>';
					return;
				}

				reviewsStatus.classList.add('hidden');
				reviewsList.innerHTML = reviews.map((review) => {
					const format = review.format || review.category || 'Media';
					const url = review.external_url
						? `<a href="${escapeHtml(review.external_url)}" target="_blank" rel="noreferrer" class="text-sm font-bold text-purple-400 hover:text-purple-300">Open</a>`
						: '';
					const details = [
						review.status,
						review.release_date,
						review.runtime,
						review.votes ? `Votes ${review.votes}` : ''
					].filter((detail): detail is string => Boolean(detail));
					return `
						<article class="bg-slate-900 border border-slate-800 rounded-xl p-6">
							<div class="mb-3 flex flex-wrap items-start justify-between gap-3">
								<div>
									<p class="mb-1 text-xs font-bold uppercase tracking-[0.18em] text-slate-500">${escapeHtml(format)}</p>
									<h3 class="text-xl font-bold text-white">${escapeHtml(review.title)}</h3>
								</div>
								${url}
							</div>
							<p class="text-sm leading-relaxed text-slate-400">${escapeHtml(review.body)}</p>
							<div class="mt-4 flex flex-wrap gap-3 text-xs font-bold uppercase tracking-[0.16em] text-slate-500">
								${ratingLabel(review.rating)}
								${details.map((detail) => `<span>${escapeHtml(detail)}</span>`).join('')}
							</div>
						</article>
					`;
				}).join('');
			} catch (error) {
				reviewsStatus.innerHTML = '<p class="text-slate-500 italic">Reviews are unavailable.</p>';
			}
		}

		loadReviews();
	</script>
</Layout>
