---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="The Vault | EPPPE.NET"
	description="Carmine Iacona's hosted services, media reviews, and creative writing."
>
	<header class="page-masthead shell">
		<div>
			<p class="eyebrow">Personal archive · 01</p>
			<h1>The<br /><em>vault</em></h1>
		</div>
		<div class="page-masthead__note">
			<p class="page-masthead__number">SERVICES / MEDIA / WRITING</p>
			<p>The services I host, the media I review, and the fiction I’m working on.</p>
		</div>
	</header>

	<div class="vault-layout shell">
		<aside class="services-panel">
			<div class="services-panel__heading">
				<p class="eyebrow">Live services · 02</p>
				<h2>Hosted services</h2>
			</div>

			<section class="service-primary">
				<div class="service-primary__status">
					<div>
						<span class="service-dot" id="mc-status-dot"></span>
						<h3>Minecraft Server</h3>
					</div>
					<span id="mc-players" aria-live="polite">Pinging…</span>
				</div>

				<button id="mc-copy-btn" class="server-address" type="button">
					<span>play.epppe.net</span>
					<small>Copy address</small>
				</button>
			</section>

			<div class="service-links">
				<a href="https://stream.epppe.net" target="_blank" rel="noreferrer">
					<span>01</span>
					<strong>Jellyfin</strong>
					<small>Media server</small>
					<i aria-hidden="true">↗</i>
				</a>
				<a href="https://map.epppe.net" target="_blank" rel="noreferrer">
					<span>02</span>
					<strong>Live Map</strong>
					<small>Minecraft world map</small>
					<i aria-hidden="true">↗</i>
				</a>
			</div>
		</aside>

		<div class="vault-archive">
			<section class="archive-section" aria-labelledby="catalog-heading">
				<div class="archive-section__heading">
					<div>
						<p class="eyebrow">Catalog · 03</p>
						<h2 id="catalog-heading">Media reviews</h2>
					</div>
					<span>Ratings and comments</span>
				</div>

				<div id="reviews-status" class="reviews-status" aria-live="polite">
					<span class="status-dot"></span>
					<p>Loading reviews…</p>
				</div>
				<div id="reviews-list" class="review-list"></div>
			</section>

			<section class="archive-section" aria-labelledby="writing-heading">
				<div class="archive-section__heading">
					<div>
						<p class="eyebrow">Original work · 04</p>
						<h2 id="writing-heading">Creative writing</h2>
					</div>
					<span>Current draft</span>
				</div>

				<article class="writing-entry">
					<span class="writing-entry__number">01</span>
					<div>
						<p>Gaslamp fantasy novella</p>
						<h3>Arelis: The City Between Bells</h3>
					</div>
					<strong>Chapter 1<br />coming soon</strong>
				</article>
			</section>
		</div>
	</div>

	<script>
		const mcIp = 'play.epppe.net';

		async function checkServer() {
			const dot = document.getElementById('mc-status-dot')!;
			const players = document.getElementById('mc-players')!;

			try {
				const response = await fetch(`https://api.mcsrvstat.us/3/${mcIp}`);
				const data = await response.json();

				if (data.online) {
					dot.classList.add('is-online');
					players.innerText = `${data.players.online} / ${data.players.max} online`;
				} else {
					dot.classList.add('is-offline');
					players.innerText = 'Offline';
				}
			} catch (error) {
				dot.classList.add('is-offline');
				players.innerText = 'Status unavailable';
			}
		}

		const copyBtn = document.getElementById('mc-copy-btn')!;
		const copyLabel = copyBtn.querySelector('small')!;

		copyBtn.addEventListener('click', async () => {
			await navigator.clipboard.writeText(mcIp);
			copyLabel.innerText = 'Copied';
			copyBtn.classList.add('is-copied');

			setTimeout(() => {
				copyLabel.innerText = 'Copy address';
				copyBtn.classList.remove('is-copied');
			}, 2000);
		});

		checkServer();

		const reviewsStatus = document.getElementById('reviews-status')!;
		const reviewsList = document.getElementById('reviews-list')!;

		function escapeHtml(value: string) {
			return String(value || '').replace(/[&<>"']/g, (char) => ({
				'&': '&amp;',
				'<': '&lt;',
				'>': '&gt;',
				'"': '&quot;',
				"'": '&#039;'
			})[char] || char);
		}

		function ratingLabel(rating: number | null) {
			if (!rating) return '';
			return `<span class="review-entry__rating">${rating}/5</span>`;
		}

		type PublishedReview = {
			title: string;
			body: string;
			category?: string;
			status?: string;
			format?: string;
			release_date?: string;
			runtime?: string;
			votes?: string;
			rating: number | null;
			external_url?: string;
		};

		async function loadReviews() {
			try {
				const response = await fetch('/api/reviews');
				const data = await response.json() as { error?: string; reviews?: PublishedReview[] };

				if (!response.ok) throw new Error(data.error || 'Unable to load reviews');

				const reviews = data.reviews || [];
				if (!reviews.length) {
					reviewsStatus.innerHTML = '<p>No published reviews yet.</p>';
					return;
				}

				reviewsStatus.hidden = true;
				reviewsList.innerHTML = reviews.map((review, index) => {
					const format = review.format || review.category || 'Media';
					const url = review.external_url
						? `<a href="${escapeHtml(review.external_url)}" target="_blank" rel="noreferrer">Open ↗</a>`
						: '';
					const details = [
						review.status,
						review.release_date,
						review.runtime,
						review.votes ? `Votes ${review.votes}` : ''
					].filter((detail): detail is string => Boolean(detail));

					return `
						<article class="review-entry">
							<div class="review-entry__index">0${index + 1}</div>
							<div class="review-entry__body">
								<p class="review-entry__format">${escapeHtml(format)}</p>
								<h3>${escapeHtml(review.title)}</h3>
								<p class="review-entry__copy">${escapeHtml(review.body)}</p>
								<div class="review-entry__details">
									${ratingLabel(review.rating)}
									${details.map((detail) => `<span>${escapeHtml(detail)}</span>`).join('')}
								</div>
							</div>
							<div class="review-entry__link">${url}</div>
						</article>
					`;
				}).join('');
			} catch (error) {
				reviewsStatus.innerHTML = '<p>Reviews are unavailable.</p>';
			}
		}

		loadReviews();
	</script>
</Layout>
