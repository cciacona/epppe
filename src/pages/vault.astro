---
import Layout from '../layouts/Layout.astro';
---

<Layout title="The Vault | EPPPE.NET">
	<div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
		<section class="rounded-3xl border border-white/10 bg-slate-950/75 p-8 shadow-[0_24px_80px_rgba(2,6,23,0.32)] sm:p-10">
			<p class="text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Archive</p>
			<h1 class="mt-4 text-4xl font-semibold tracking-tight text-white">The Vault</h1>
			<p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">Homelab services, media reviews, and creative writing.</p>
		</section>

		<div class="mt-8 grid gap-6 xl:grid-cols-[360px_1fr]">
			<div class="space-y-6">
				<div class="rounded-3xl border border-white/10 bg-slate-950/65 p-6 shadow-[0_18px_60px_rgba(2,6,23,0.25)]">
					<div class="flex items-center justify-between gap-4">
						<h2 class="flex items-center gap-2 text-lg font-semibold text-white">
							<span class="h-3 w-3 rounded-full bg-slate-500" id="mc-status-dot"></span>
							Minecraft Server
						</h2>
						<span id="mc-players" class="text-sm text-slate-400">Pinging...</span>
					</div>

					<button
						id="mc-copy-btn"
						class="mt-5 w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 font-mono text-sm font-semibold text-cyan-300 transition-colors hover:border-cyan-300/40 hover:bg-cyan-300/10 hover:text-cyan-100 focus:outline-none focus:ring-2 focus:ring-cyan-300/40"
					>
						play.epppe.net
					</button>
					<p class="mt-2 text-center text-xs text-slate-500">Click to copy server address</p>
				</div>

				<div class="grid grid-cols-2 gap-4">
					<a href="https://stream.epppe.net" target="_blank" class="rounded-2xl border border-white/10 bg-slate-950/65 p-4 text-center transition-colors hover:border-cyan-300/40 hover:bg-cyan-300/5">
						<span class="mb-1 block font-semibold text-cyan-300">Jellyfin</span>
						<span class="text-xs text-slate-400">Media Server</span>
					</a>
					<a href="https://map.epppe.net" target="_blank" class="rounded-2xl border border-white/10 bg-slate-950/65 p-4 text-center transition-colors hover:border-emerald-300/40 hover:bg-emerald-300/5">
						<span class="mb-1 block font-semibold text-emerald-300">Live Map</span>
						<span class="text-xs text-slate-400">Server Render</span>
					</a>
				</div>
			</div>

			<div class="space-y-6">
				<section class="rounded-3xl border border-white/10 bg-slate-950/65 p-6 shadow-[0_18px_60px_rgba(2,6,23,0.25)]">
					<h2 class="text-lg font-semibold uppercase tracking-[0.22em] text-slate-400">Media Catalog</h2>
					<div id="reviews-status" class="mt-6 flex min-h-32 items-center justify-center rounded-2xl border border-white/10 bg-white/5 p-6">
						<p class="italic text-slate-500">Loading reviews...</p>
					</div>
					<div id="reviews-list" class="mt-4 space-y-4"></div>
				</section>

				<section class="rounded-3xl border border-white/10 bg-slate-950/65 p-6 shadow-[0_18px_60px_rgba(2,6,23,0.25)]">
					<h2 class="text-lg font-semibold uppercase tracking-[0.22em] text-slate-400">Creative Writing</h2>
					<article class="mt-6 rounded-2xl border border-white/10 bg-white/5 p-5">
						<h3 class="text-lg font-semibold text-white">Arelis: The City Between Bells</h3>
						<p class="mt-2 text-sm text-slate-400">An original gaslamp fantasy novella.</p>
						<p class="mt-2 text-sm text-slate-400">Chapter 1 Coming Soon.</p>
					</article>
				</section>
			</div>
		</div>

<!-- Client-side JavaScript for the Minecraft Widget -->
	<script>
		const mcIp = 'play.epppe.net';
		
		// 1. Fetch live server data
		async function checkServer() {
			try {
				const response = await fetch(`https://api.mcsrvstat.us/3/${mcIp}`);
				const data = await response.json();
				
				// Add "!" to tell TypeScript these elements definitely exist
				const dot = document.getElementById('mc-status-dot')!;
				const players = document.getElementById('mc-players')!;
				
				if (data.online) {
					dot.classList.replace('bg-slate-600', 'bg-green-500');
					dot.classList.add('shadow-[0_0_10px_rgba(34,197,94,0.5)]'); // Green glow
					players.innerText = ` ${data.players.online} / ${data.players.max} Online`;
				} else {
					dot.classList.replace('bg-slate-600', 'bg-red-500');
					players.innerText = 'Offline';
				}
			} catch (error) {
				// Added "!" here as well
				document.getElementById('mc-players')!.innerText = 'Error checking status';
			}
		}

		// 2. Click to copy functionality
		// Add "!" to tell TypeScript the button exists
		const copyBtn = document.getElementById('mc-copy-btn')!;
		
		copyBtn.addEventListener('click', async () => {
			await navigator.clipboard.writeText(mcIp);
			const originalText = copyBtn.innerText;
			
			copyBtn.innerText = 'Copied to clipboard!';
			copyBtn.classList.replace('text-cyan-300', 'text-white');
			copyBtn.classList.add('bg-cyan-600');
			
			setTimeout(() => {
				copyBtn.innerText = originalText;
				copyBtn.classList.replace('text-white', 'text-cyan-300');
				copyBtn.classList.remove('bg-cyan-600');
			}, 2000);
		});

		// Run the check when the page loads
		checkServer();

		const reviewsStatus = document.getElementById('reviews-status')!;
		const reviewsList = document.getElementById('reviews-list')!;

		function escapeHtml(value: string) {
			return String(value || '').replace(/[&<>"']/g, (char) => ({
				'&': '&amp;',
				'<': '&lt;',
				'>': '&gt;',
				'"': '&quot;',
				"'": '&#039;'
			})[char] || char);
		}

		function ratingLabel(rating: number | null) {
			if (!rating) return '';
			return `<span class="text-cyan-300">${rating}/5</span>`;
		}

		type PublishedReview = {
			title: string;
			body: string;
			category?: string;
			status?: string;
			format?: string;
			release_date?: string;
			runtime?: string;
			votes?: string;
			rating: number | null;
			external_url?: string;
		};

		async function loadReviews() {
			try {
				const response = await fetch('/api/reviews');
				const data = await response.json() as { error?: string; reviews?: PublishedReview[] };

				if (!response.ok) throw new Error(data.error || 'Unable to load reviews');

				const reviews = data.reviews || [];
				if (!reviews.length) {
					reviewsStatus.innerHTML = '<p class="text-slate-500 italic">No published reviews yet.</p>';
					return;
				}

				reviewsStatus.classList.add('hidden');
				reviewsList.innerHTML = reviews.map((review) => {
					const format = review.format || review.category || 'Media';
					const url = review.external_url
						? `<a href="${escapeHtml(review.external_url)}" target="_blank" rel="noreferrer" class="text-sm font-semibold text-cyan-300 hover:text-cyan-200">Open</a>`
						: '';
					const details = [
						review.status,
						review.release_date,
						review.runtime,
						review.votes ? `Votes ${review.votes}` : ''
					].filter((detail): detail is string => Boolean(detail));
					return `
						<article class="rounded-2xl border border-white/10 bg-white/5 p-6">
							<div class="mb-3 flex flex-wrap items-start justify-between gap-3">
								<div>
									<p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">${escapeHtml(format)}</p>
									<h3 class="text-xl font-bold text-white">${escapeHtml(review.title)}</h3>
								</div>
								${url}
							</div>
							<p class="text-sm leading-relaxed text-slate-400">${escapeHtml(review.body)}</p>
							<div class="mt-4 flex flex-wrap gap-3 text-xs font-bold uppercase tracking-[0.16em] text-slate-500">
								${ratingLabel(review.rating)}
								${details.map((detail) => `<span>${escapeHtml(detail)}</span>`).join('')}
							</div>
						</article>
					`;
				}).join('');
			} catch (error) {
				reviewsStatus.innerHTML = '<p class="text-slate-500 italic">Reviews are unavailable.</p>';
			}
		}

		loadReviews();
	</script>
</Layout>
