---
import Layout from '../../../layouts/Layout.astro';
import CompositionNav from '../../../components/CompositionNav.astro';
import { outcomes } from '../../../data/composition';

const connectionCount = outcomes.reduce((total, outcome) => total + outcome.evidence.length, 0);
---

<Layout
	title="Outcomes & Reflections | Composition Research Portfolio"
	description="Carmine Iacona’s reflections on all six ENC 1102 course outcomes, with direct explanations of how each selected artifact demonstrates the outcome."
	image="/portfolio/composition/og.png"
>
	<CompositionNav />

	<header class="outcomes-masthead">
		<div class="shell outcomes-masthead__inner">
			<div>
				<p class="eyebrow">ENC 1102 · Final ePortfolio</p>
				<h1>Outcomes & <em>Reflections</em></h1>
				<p class="outcomes-masthead__deck">
					Each section shows the official course outcome, what I learned, and the artifacts I chose as evidence. Under each artifact, I explain why I connected it to that outcome.
				</p>
			</div>
			<aside class="outcomes-masthead__summary" aria-label="Page summary">
				<div><strong>06</strong><span>Course outcomes</span></div>
				<div><strong>{String(connectionCount).padStart(2, '0')}</strong><span>Artifact connections</span></div>
				<p>Use the outcome menu below to jump directly to a reflection.</p>
			</aside>
		</div>
	</header>

	<div class="outcome-jump-mobile">
		<div class="shell outcome-jump-mobile__inner">
			<label for="outcome-select">Jump to an outcome</label>
			<select id="outcome-select">
				<option value="">Choose a reflection</option>
				{outcomes.map((outcome) => <option value={`#${outcome.id}`}>{outcome.number} · {outcome.title}</option>)}
			</select>
			<button id="outcome-select-go" type="button">Go</button>
		</div>
	</div>

	<section id="outcome-map" class="shell outcomes-layout" aria-label="Outcome map" tabindex="-1">
		<aside class="outcome-jump">
			<p class="outcome-jump__label">Jump to an outcome</p>
			<nav aria-label="Course outcome reflections">
				{outcomes.map((outcome) => (
					<a href={`#${outcome.id}`}>
						<span>{outcome.number}</span>
						{outcome.title}
					</a>
				))}
			</nav>
			<a class="outcome-jump__artifacts" href="/portfolio/composition/artifacts">View the Artifact Index →</a>
		</aside>

		<div class="outcome-reflections">
			{outcomes.map((outcome, outcomeIndex) => (
				<article id={outcome.id} class="outcome" aria-labelledby={`${outcome.id}-title`}>
					<header class="outcome__header">
						<div class="outcome__number">
							<span>{outcome.number}</span>
							<p>Outcome</p>
						</div>
						<div>
							<h2 id={`${outcome.id}-title`}>{outcome.title}</h2>
							<div class="outcome__wording">
								<p>Official course outcome</p>
								<blockquote>{outcome.wording}</blockquote>
							</div>
						</div>
					</header>

					<section class="outcome__reflection" aria-labelledby={`${outcome.id}-reflection`}>
						<h3 id={`${outcome.id}-reflection`}>My Reflection: What I Learned</h3>
						<div>
							{outcome.reflection.map((paragraph) => <p>{paragraph}</p>)}
						</div>
					</section>

					<section class="outcome__evidence" aria-labelledby={`${outcome.id}-evidence`}>
						<div class="outcome__evidence-heading">
							<h3 id={`${outcome.id}-evidence`}>How the Artifacts Demonstrate This Outcome</h3>
							<p>{outcome.evidence.length} {outcome.evidence.length === 1 ? 'artifact' : 'artifacts'}</p>
						</div>
						<div class="outcome__evidence-grid">
							{outcome.evidence.map((item, index) => (
								<article>
									<span class="outcome__evidence-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h4>{item.title}</h4>
									<p class="outcome__connection-label">Why it connects</p>
									<p class="outcome__connection">{item.connection}</p>
									<a href={item.href} aria-label={`Open ${item.title}`}>Open artifact <span aria-hidden="true">→</span></a>
								</article>
							))}
						</div>
					</section>

					<nav class="outcome__pager" aria-label={`${outcome.title} navigation`}>
						{outcomeIndex > 0 && <a href={`#${outcomes[outcomeIndex - 1].id}`}><span aria-hidden="true">←</span> Previous outcome</a>}
						<a class="outcome__pager-map" href="#outcome-map">Back to outcome map <span aria-hidden="true">↑</span></a>
						{outcomeIndex < outcomes.length - 1 && <a href={`#${outcomes[outcomeIndex + 1].id}`}>Next outcome <span aria-hidden="true">→</span></a>}
					</nav>
				</article>
			))}

			<aside class="outcomes-return">
				<div>
					<p class="eyebrow">Next</p>
					<h2>View all eleven artifacts.</h2>
					<p>The Artifact Index links each artifact back to the reflections where I discuss it.</p>
				</div>
				<a class="button button--primary" href="/portfolio/composition/artifacts">Open the Artifact Index <span aria-hidden="true">→</span></a>
			</aside>
		</div>
	</section>

	<script>
		const outcomeSelect = document.querySelector<HTMLSelectElement>('#outcome-select');
		const outcomeGo = document.querySelector<HTMLButtonElement>('#outcome-select-go');
		outcomeGo?.addEventListener('click', () => {
			const target = outcomeSelect?.value;
			if (target) window.location.hash = target;
		});
	</script>
</Layout>

<style>
	.outcomes-masthead {
		position: relative;
		overflow: hidden;
		padding-block: clamp(44px, 6vw, 68px);
		border-bottom: 1px solid var(--rule);
		background:
			linear-gradient(90deg, transparent 0 68%, rgba(193, 165, 126, 0.055) 68% 68.1%, transparent 68.1%),
			radial-gradient(circle at 82% 14%, rgba(91, 123, 100, 0.2), transparent 24rem);
	}

	.outcomes-masthead__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(270px, 0.34fr);
		gap: clamp(48px, 8vw, 112px);
		align-items: end;
	}

	.outcomes-masthead__back {
		display: inline-block;
		margin-bottom: 34px;
		color: var(--sage);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.outcomes-masthead__back::before {
		margin-right: 10px;
		content: "←";
		color: var(--tan);
	}

	.outcomes-masthead h1 {
		margin: 16px 0 0;
		color: var(--cream);
		font-family: var(--display);
		font-size: clamp(3.2rem, 6vw, 5.6rem);
		font-weight: 400;
		letter-spacing: -0.052em;
		line-height: 0.9;
	}

	.outcomes-masthead h1 em {
		color: var(--sage);
		font-weight: 400;
	}

	.outcomes-masthead__deck {
		max-width: 720px;
		margin: 22px 0 0;
		color: var(--muted);
		font-size: clamp(1rem, 1.5vw, 1.14rem);
		line-height: 1.8;
	}

	.outcomes-masthead__summary {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		border: 1px solid var(--rule-strong);
		background: rgba(16, 35, 28, 0.78);
	}

	.outcomes-masthead__summary div {
		display: grid;
		gap: 3px;
		padding: 22px;
	}

	.outcomes-masthead__summary div + div {
		border-left: 1px solid var(--rule);
	}

	.outcomes-masthead__summary strong {
		color: var(--cream);
		font-family: var(--display);
		font-size: 2rem;
		font-weight: 400;
	}

	.outcomes-masthead__summary span {
		color: var(--muted);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.outcomes-masthead__summary > p {
		grid-column: 1 / -1;
		margin: 0;
		padding: 18px 22px;
		border-top: 1px solid var(--rule);
		color: var(--sage-bright);
		font-size: 0.78rem;
		line-height: 1.55;
	}

	.outcomes-layout {
		display: grid;
		grid-template-columns: 230px minmax(0, 1fr);
		gap: clamp(52px, 7vw, 94px);
		padding-block: 58px 110px;
	}

	.outcome-jump {
		position: sticky;
		top: 154px;
		align-self: start;
	}

	.outcome-jump__label {
		margin: 0 0 15px;
		color: var(--tan);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.outcome-jump nav {
		border-top: 1px solid var(--rule-strong);
	}

	.outcome-jump nav a {
		display: grid;
		grid-template-columns: 26px 1fr;
		gap: 9px;
		padding: 13px 0;
		border-bottom: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 700;
		line-height: 1.35;
		transition: color 180ms ease, padding-left 180ms ease;
	}

	.outcome-jump nav a:hover {
		padding-left: 5px;
		color: var(--cream);
	}

	.outcome-jump nav span {
		color: var(--rule-strong);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.65rem;
	}

	.outcome-jump__artifacts {
		display: inline-block;
		margin-top: 22px;
		color: var(--sage-bright);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.outcome-reflections {
		min-width: 0;
	}

	.outcome {
		scroll-margin-top: 154px;
		padding-bottom: clamp(84px, 11vw, 136px);
	}

	.outcome + .outcome {
		padding-top: clamp(76px, 9vw, 112px);
		border-top: 1px solid var(--rule-strong);
	}

	.outcome__header {
		display: grid;
		grid-template-columns: 80px minmax(0, 1fr);
		gap: clamp(24px, 4vw, 42px);
		align-items: start;
	}

	.outcome__number {
		padding-top: 7px;
		border-right: 1px solid var(--rule-strong);
	}

	.outcome__number span {
		color: var(--tan);
		font-family: var(--display);
		font-size: 2.6rem;
		line-height: 1;
	}

	.outcome__number p {
		margin: 7px 0 0;
		color: var(--muted);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.outcome h2 {
		margin: 0;
		color: var(--cream);
		font-family: var(--display);
		font-size: clamp(3rem, 5.7vw, 5.5rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 0.94;
	}

	.outcome__wording {
		max-width: 820px;
		margin-top: 24px;
		padding: 17px 20px;
		border-left: 2px solid var(--sage);
		background: rgba(91, 123, 100, 0.08);
	}

	.outcome__wording p {
		margin: 0 0 7px;
		color: var(--sage-bright);
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.outcome__wording blockquote {
		margin: 0;
		color: var(--cream-soft);
		font-size: 0.88rem;
		line-height: 1.65;
	}

	.outcome__reflection,
	.outcome__evidence {
		margin-top: 42px;
	}

	.outcome__reflection > h3,
	.outcome__evidence-heading h3 {
		margin: 0 0 22px;
		color: var(--cream);
		font-family: var(--display);
		font-size: clamp(1.9rem, 3.2vw, 2.8rem);
		font-weight: 400;
		letter-spacing: -0.025em;
		line-height: 1;
	}

	.outcome__reflection > div {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 28px 42px;
	}

	.outcome__reflection p {
		margin: 0;
		color: var(--cream-soft);
		font-size: clamp(1rem, 1.3vw, 1.06rem);
		line-height: 1.9;
	}

	.outcome__evidence-heading {
		display: flex;
		gap: 24px;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 18px;
	}

	.outcome__evidence-heading h3,
	.outcome__evidence-heading p {
		margin: 0;
	}

	.outcome__evidence-heading p {
		color: var(--muted);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.68rem;
	}

	.outcome__evidence-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		border: 1px solid var(--rule-strong);
		background: var(--rule);
	}

	.outcome__evidence-grid > article {
		display: flex;
		flex-direction: column;
		min-height: 270px;
		padding: 24px;
		background: var(--paper-soft);
	}

	.outcome__evidence-grid > article:last-child:nth-child(odd) {
		grid-column: 1 / -1;
	}

	.outcome__evidence-number {
		color: var(--rule-strong);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.68rem;
	}

	.outcome__evidence-grid h4 {
		margin-top: 24px;
		margin-bottom: 0;
		color: var(--cream);
		font-family: var(--display);
		font-size: clamp(1.7rem, 2.8vw, 2.5rem);
		font-weight: 400;
		line-height: 1.04;
	}

	.outcome__connection-label {
		margin-top: 22px;
		margin-bottom: 0;
		color: var(--sage-bright);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}

	.outcome__connection {
		margin-top: 7px;
		margin-bottom: 0;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.65;
	}

	.outcome__evidence-grid article > a {
		margin-top: auto;
		padding-top: 24px;
		color: var(--sage-bright);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.outcome__pager {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 24px;
		align-items: center;
		justify-content: space-between;
		margin-top: 28px;
		padding-top: 20px;
		border-top: 1px solid var(--rule);
	}

	.outcome__pager a {
		color: var(--sage-bright);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.outcome__pager-map {
		margin-inline: auto;
		color: var(--muted) !important;
	}

	.outcome-jump-mobile {
		display: none;
	}

	.outcomes-return {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 36px;
		align-items: end;
		padding: clamp(28px, 5vw, 48px);
		border: 1px solid var(--rule-strong);
		background: var(--forest-deep);
	}

	.outcomes-return h2 {
		margin: 10px 0 0;
		color: var(--cream);
		font-family: var(--display);
		font-size: clamp(2.3rem, 4vw, 3.8rem);
		font-weight: 400;
		line-height: 1;
	}

	.outcomes-return div > p:last-child {
		max-width: 620px;
		margin: 16px 0 0;
		color: var(--muted);
		font-size: 0.88rem;
		line-height: 1.65;
	}

	@media (max-width: 1100px) {
		.outcomes-masthead__inner,
		.outcomes-layout {
			grid-template-columns: 1fr;
		}

		.outcomes-masthead__summary {
			max-width: 560px;
		}

		.outcome-jump {
			display: none;
		}

		.outcome-jump-mobile {
			position: sticky;
			top: 78px;
			z-index: 45;
			display: block;
			border-block: 1px solid var(--rule);
			background: rgba(16, 35, 28, 0.97);
			backdrop-filter: blur(14px);
		}

		.outcome-jump-mobile__inner {
			display: flex;
			gap: 14px;
			align-items: center;
			min-height: 58px;
		}

		.outcome-jump-mobile label {
			color: var(--cream);
			font-size: 0.78rem;
			font-weight: 700;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			white-space: nowrap;
		}

		.outcome-jump-mobile select {
			width: 100%;
			min-width: 0;
			min-height: 42px;
			padding: 7px 34px 7px 12px;
			border: 1px solid var(--rule-strong);
			border-radius: 0;
			background: var(--paper-soft);
			color: var(--cream);
			font: inherit;
			font-size: 0.86rem;
		}

		.outcome-jump-mobile button {
			flex: none;
			min-width: 48px;
			min-height: 42px;
			padding: 7px 12px;
			border: 1px solid var(--tan);
			border-radius: 0;
			background: var(--tan);
			color: var(--forest);
			font: inherit;
			font-size: 0.78rem;
			font-weight: 800;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			cursor: pointer;
		}

		.outcome-jump-mobile button:hover,
		.outcome-jump-mobile button:focus-visible {
			background: var(--cream);
			border-color: var(--cream);
		}

		.outcome {
			scroll-margin-top: 137px;
		}
	}

	@media (max-width: 700px) {
		.outcomes-masthead__inner,
		.outcomes-layout {
			width: min(100% - 32px, 1180px);
		}

		.outcomes-masthead h1 {
			font-size: clamp(3rem, 14vw, 4.4rem);
		}

		.outcome__header {
			grid-template-columns: 54px minmax(0, 1fr);
			gap: 18px;
		}

		.outcome__number span {
			font-size: 2rem;
		}

		.outcome__reflection > div,
		.outcome__evidence-grid,
		.outcomes-return {
			grid-template-columns: 1fr;
		}

		.outcome__evidence-grid > article {
			min-height: 0;
		}

		.outcome__pager {
			justify-content: center;
		}

		.outcomes-return {
			align-items: start;
		}
	}

	@media (max-width: 680px) {
		.outcome-jump-mobile {
			top: 67px;
		}

		.outcome {
			scroll-margin-top: 126px;
		}
	}

	@media (max-width: 480px) {
		.outcome-jump-mobile label {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}
	}
</style>
