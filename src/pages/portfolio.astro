---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portfolio | EPPPE.NET">
	<div class="max-w-5xl mx-auto px-6 py-16">
		<header class="mb-12">
			<h1 class="text-4xl font-bold text-white mb-3">Portfolio</h1>
			<p class="text-slate-400 max-w-2xl leading-relaxed">
				A home for professional project work and composition research.
			</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<section class="bg-slate-900/70 border border-slate-800 rounded-lg p-6 hover:border-purple-500/50 transition-colors">
				<p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-purple-400">Business</p>
				<h2 class="text-2xl font-bold text-white mb-3">Business Portfolio</h2>
				<p class="text-slate-400 leading-relaxed">
					Professional work, technical projects, infrastructure experience, and service-focused accomplishments.
				</p>
			</section>

			<section class="bg-slate-900/70 border border-slate-800 rounded-lg p-6 hover:border-purple-500/50 transition-colors">
				<p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-purple-400">Research</p>
				<h2 class="text-2xl font-bold text-white mb-3">Composition Research Portfolio</h2>
				<p class="text-slate-400 leading-relaxed">
					Research materials, writing artifacts, and class portfolio work for composition.
				</p>
			</section>
		</div>
	</div>
</Layout>
