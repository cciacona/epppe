---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portfolio | EPPPE.NET">
	<div class="mx-auto max-w-5xl px-6 py-16">
		<header class="mb-14">
			<p class="mb-3 text-sm font-bold text-purple-300">Index</p>
			<h1 class="mb-4 text-4xl font-bold text-white">Portfolio</h1>
			<p class="max-w-2xl leading-relaxed text-slate-400">
				A small index for technical work, course artifacts, and writing that needs more context than a home page can hold.
			</p>
		</header>

		<div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
			<section class="lg:col-span-2">
				<h2 class="mb-4 border-b border-slate-800 pb-2 text-2xl font-bold text-white">Shelves</h2>

				<div class="divide-y divide-slate-800 border-y border-slate-800">
					<section class="py-6">
						<div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
							<div>
								<p class="text-sm font-bold text-slate-500">Business</p>
							</div>
							<div class="sm:col-span-3">
								<h3 class="mb-2 text-2xl font-bold text-white">Business Portfolio</h3>
								<p class="leading-relaxed text-slate-400">
									Cloud, systems, and infrastructure work will live here as case studies instead of loose project blurbs.
								</p>
								<p class="mt-3 text-sm font-bold text-slate-500">Status: collecting project evidence</p>
							</div>
						</div>
					</section>

					<a href="/portfolio/composition" class="block py-6 transition-colors hover:bg-slate-900/40">
						<div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
							<div>
								<p class="text-sm font-bold text-purple-300">Composition</p>
							</div>
							<div class="sm:col-span-3">
								<div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
									<h3 class="text-2xl font-bold text-white">Composition Research Portfolio</h3>
									<span class="text-sm font-bold text-purple-300">Open page</span>
								</div>
								<p class="mt-2 leading-relaxed text-slate-400">
									Cover letter, student learning outcome reflections, major writing assignments, drafts, activities, and evidence.
								</p>
								<p class="mt-3 text-sm font-bold text-slate-500">Status: structure ready for course artifacts</p>
							</div>
						</div>
					</a>
				</div>
			</section>

			<aside class="border-t border-slate-800 pt-6 lg:border-l lg:border-t-0 lg:pl-6 lg:pt-0">
				<h2 class="mb-4 text-xl font-bold text-white">What Lives Here</h2>
				<div class="space-y-5 text-sm leading-relaxed text-slate-400">
					<p>
						The home page gives the short version. Portfolio pages carry the evidence, drafts, and context.
					</p>
					<p>
						The Vault remains separate: services, catalog entries, and personal archive material.
					</p>
				</div>
			</aside>
		</div>
	</div>
</Layout>
