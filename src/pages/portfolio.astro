---
import Layout from '../layouts/Layout.astro';

const collections = [
	{
		number: '01',
		kicker: 'Business',
		title: 'Business Portfolio',
		description: 'Cloud, systems, and infrastructure work will live here as case studies instead of loose project blurbs.',
		status: 'Collecting project evidence',
		href: null
	},
	{
		number: '02',
		kicker: 'Composition',
		title: 'Composition Research Portfolio',
		description: 'Cover letter, student learning outcome reflections, major writing assignments, drafts, activities, and evidence.',
		status: 'Structure ready for course artifacts',
		href: '/portfolio/composition'
	}
];
---

<Layout
	title="Portfolio | EPPPE.NET"
	description="Technical case studies, course artifacts, and long-form work by Carmine Iacona."
>
	<header class="page-masthead shell">
		<div>
			<p class="eyebrow">Index · 01</p>
			<h1>Selected<br /><em>portfolio</em></h1>
		</div>
		<div class="page-masthead__note">
			<p class="page-masthead__number">02 / COLLECTIONS</p>
			<p>
				Technical work, course artifacts, and writing with enough room for the evidence—not just the headline.
			</p>
		</div>
	</header>

	<section class="portfolio-index shell" aria-labelledby="portfolio-shelves">
		<div class="portfolio-index__heading">
			<h2 id="portfolio-shelves">The shelves</h2>
			<p>Active and developing bodies of work.</p>
		</div>

		<div class="collection-list">
			{collections.map((collection) => (
				<article class:list={['collection-row', { 'collection-row--linked': collection.href }]}>
					<div class="collection-row__number">{collection.number}</div>
					<div>
						<p class="eyebrow">{collection.kicker}</p>
						<h3>{collection.title}</h3>
					</div>
					<div class="collection-row__details">
						<p>{collection.description}</p>
						<span>{collection.status}</span>
					</div>
					{collection.href ? (
						<a href={collection.href} class="collection-row__link" aria-label={`Open ${collection.title}`}>
							Open
							<span aria-hidden="true">↗</span>
						</a>
					) : (
						<span class="collection-row__pending">In progress</span>
					)}
				</article>
			))}
		</div>
	</section>

	<aside class="portfolio-note">
		<div class="shell portfolio-note__inner">
			<p class="eyebrow">A note on structure · 02</p>
			<p>
				The home page is the short version. These pages carry the process, drafts, decisions, and context.
				The Vault stays separate: services, catalog entries, and personal archive material.
			</p>
		</div>
	</aside>
</Layout>
