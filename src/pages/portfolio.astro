---
import Layout from '../layouts/Layout.astro';

const collections = [
	{
		number: '01',
		kicker: 'Business',
		title: 'Business Portfolio',
		description: 'My Proxmox home server, Factorio 2.1 mod work, and this website will be the first case studies here.',
		status: 'In progress',
		href: null
	},
	{
		number: '02',
		kicker: 'ENC 1102',
		title: 'Composition Research Portfolio',
		description: 'My research on student-run class group chats, including five interviews, three Gordon Rule assignments, six outcome reflections, and revision history.',
		status: 'Complete course portfolio',
		href: '/portfolio/composition'
	}
];
---

<Layout
	title="Portfolio | EPPPE.NET"
	description="Technical projects and the ENC 1102 composition portfolio of Carmine Iacona."
>
	<header class="page-masthead shell">
		<div>
			<p class="eyebrow">Index · 01</p>
			<h1>My<br /><em>portfolio</em></h1>
		</div>
		<div class="page-masthead__note">
			<p class="page-masthead__number">02 / SECTIONS</p>
			<p>Technical projects and my ENC 1102 composition portfolio.</p>
		</div>
	</header>

	<section class="portfolio-index shell" aria-labelledby="portfolio-shelves">
		<div class="portfolio-index__heading">
			<h2 id="portfolio-shelves">Portfolio sections</h2>
			<p>One in progress, one complete.</p>
		</div>

		<div class="collection-list">
			{collections.map((collection) => (
				<article class:list={['collection-row', { 'collection-row--linked': collection.href }]}>
					<div class="collection-row__number">{collection.number}</div>
					<div>
						<p class="eyebrow">{collection.kicker}</p>
						<h3>{collection.title}</h3>
					</div>
					<div class="collection-row__details">
						<p>{collection.description}</p>
						<span>{collection.status}</span>
					</div>
					{collection.href ? (
						<a href={collection.href} class="collection-row__link" aria-label={`Open ${collection.title}`}>
							Open
							<span aria-hidden="true">↗</span>
						</a>
					) : (
						<span class="collection-row__pending">In progress</span>
					)}
				</article>
			))}
		</div>
	</section>
</Layout>
